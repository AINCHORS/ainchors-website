APP_NAME=AINCHORS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# The sole administrator still signs in through the normal /login page.
AINCHORS_ADMIN_EMAIL=info@ainchors.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Existing local MySQL / MariaDB schema. Do not run migrations to recreate it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ainchors
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Keep demo for ordinary local work. Switch to hosted only after adding valid
# Stripe/PayPal sandbox credentials; use live only on the production server.
PAYMENT_DRIVER=demo
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_PROVIDERS=stripe,paypal

# Stripe Checkout. Prefer a least-privilege rk_test_/rk_live_ restricted key;
# use a separate whsec_ signing secret for each webhook endpoint/environment.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal Orders v2. All three values are required. Create separate sandbox and
# live REST apps and register /payments/paypal/webhook for PAYMENT.CAPTURE.COMPLETED.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Provider-hosted Stripe invoice domains only. Do not add AINCHORS domains:
# this application does not generate or host its own invoice/receipt document.
STRIPE_INVOICE_HOSTS=invoice.stripe.com,pay.stripe.com

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@ainchors.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
